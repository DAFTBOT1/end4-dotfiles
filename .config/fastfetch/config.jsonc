{
  /////===== LOGO =====/////
  "logo": {
    "type": "auto",
    "source": "$( ls $HOME/.config/fastfetch/png/* $HOME/.config/fastfetch/ascii/* | shuf -n 1)",
    "height": 10,
    "padding": {
      "top": 4,
      "left": 2,
      "right": 2
    }
  },
  "display": {
    "separator": " "
  },
  /////===== MODULES =====/////
  "modules": [
    {
      "type": "custom",
      "key": "╭────────────╮",
      "keyColor": "blue"
    },
    {
      "key": "│  user    {#34} │",
      "type": "title",
      "format": "{host-name}",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "key": "├────────────┤",
      "keyColor": "blue"
    },
    {
      "type": "os",
      "key": "│ {icon} OS      {#keys}{#34} │",
      "format": "{#38}{name} {#keys} {#34}",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "│  Kernel  {#keys}{#34} │",
      "keyColor": "blue"
    },
    {
      "type": "de",
      "key": "│  DE      {#keys}{#34} │",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "│  WM      {#keys}{#34} │",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "│ 󰏗 Packages{#keys}{#34} │",
      "keyColor": "blue",
      "disabled": [
        "apk"
      ],
      "combined": false
    },
    {
      "type": "custom",
      "key": "╰────────────╯",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "key": "╭────────────╮"
    },
    {
      "type": "memory",
      "key": "│  Memory  {#keys} │",
      "format": "{#38}{used} / {total}{#keys} "
    },
    {
      "type": "disk",
      "key": "│  Disk    {#keys} │",
      "format": "{#38}{size-used} / {size-total}{#keys} "
    },
    {
      "type": "swap",
      "key": "│  Swap    {#keys} │",
      "format": "{#38}{used} / {total}{#keys}"
    },
    {
      "type": "cpu",
      "key": "│  CPU     {#keys} │",
      // Hanya menampilkan nama CPU tanpa kecepatan/clock speed & core
      "format": "{#38}{name}{#keys}"
    },
    {
      "type": "gpu",
      "key": "│  GPU     {#keys} │",
      // Menghapus {type} agar tidak muncul teks (Integrated/Discrete)
      "format": "{#38}{name}{#keys}"
    },
    {
      "type": "host",
      "key": "│ 󰌢 Chassis  {#keys}│"
    },
    {
      "type": "battery",
      "key": "│  Battery {#keys} │"
    },
    {
      "type": "custom",
      "key": "╰────────────╯"
    }
  ]
}
